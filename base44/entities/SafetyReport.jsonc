{
  "name": "SafetyReport",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "Online Harassment",
        "Cyberstalking",
        "Threat",
        "Phishing",
        "Offline Incident",
        "Other"
      ]
    },
    "description": {
      "type": "string"
    },
    "evidence_notes": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "category",
    "description"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}