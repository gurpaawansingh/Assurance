{
  "name": "PrivacySettings",
  "type": "object",
  "properties": {
    "location_enabled": {
      "type": "boolean",
      "default": false
    },
    "retention": {
      "type": "string",
      "default": "session"
    },
    "ai_analysis_enabled": {
      "type": "boolean",
      "default": true
    },
    "session_auto_delete": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}