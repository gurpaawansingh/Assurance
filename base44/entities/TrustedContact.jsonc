{
  "name": "TrustedContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "alert_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sms",
          "whatsapp",
          "email",
          "push"
        ]
      }
    },
    "is_priority": {
      "type": "boolean",
      "default": false
    },
    "alert_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}